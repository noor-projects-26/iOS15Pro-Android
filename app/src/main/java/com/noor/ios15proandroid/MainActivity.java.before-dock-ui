public class MainActivity extends Activity {

    private final int BG = Color.rgb(15, 16, 21);
    private final int CARD = Color.rgb(29, 31, 39);
    private final int WHITE = Color.WHITE;
    private final int MUTED = Color.LTGRAY;

    private int dp(int value) {
        return (int) (value * getResources()
                .getDisplayMetrics().density);
    }

    private TextView makeText(String value, int size, int color) {
        TextView t = new TextView(this);
        t.setText(value);
        t.setTextSize(size);
        t.setTextColor(color);
        return t;
    }

    private LinearLayout makeCard() {
        LinearLayout card = new LinearLayout(this);
        card.setOrientation(LinearLayout.VERTICAL);
        card.setPadding(dp(18), dp(15), dp(18), dp(15));
        card.setBackgroundColor(CARD);

        LinearLayout.LayoutParams params =
                new LinearLayout.LayoutParams(-1, -2);
        params.bottomMargin = dp(12);
        card.setLayoutParams(params);

        return card;
    }

    private void addInfo(LinearLayout parent,
                         String label, String value) {
        LinearLayout row = new LinearLayout(this);
        row.setOrientation(LinearLayout.VERTICAL);

        TextView name = makeText(label, 12, MUTED);
        TextView data = makeText(value, 17, WHITE);
        data.setTypeface(Typeface.DEFAULT_BOLD);

        row.addView(name);

        LinearLayout.LayoutParams valueParams =
                new LinearLayout.LayoutParams(-1, -2);
        valueParams.topMargin = dp(5);
        row.addView(data, valueParams);

        LinearLayout.LayoutParams rowParams =
                new LinearLayout.LayoutParams(-1, -2);
        rowParams.bottomMargin = dp(16);
        parent.addView(row, rowParams);
    }



    private void addHomeAppIcon(
            GridLayout grid, ResolveInfo info,
            PackageManager pm, int index) {

        LinearLayout tile = new LinearLayout(this);
        tile.setOrientation(LinearLayout.VERTICAL);
        tile.setGravity(Gravity.CENTER);
        tile.setPadding(dp(3), dp(8), dp(3), dp(8));

        ImageView icon = new ImageView(this);
        icon.setImageDrawable(info.loadIcon(pm));
        icon.setScaleType(ImageView.ScaleType.FIT_CENTER);

        LinearLayout.LayoutParams iconParams =
                new LinearLayout.LayoutParams(dp(50), dp(50));
        tile.addView(icon, iconParams);

        TextView label = makeText(
                info.loadLabel(pm).toString(), 10, WHITE);
        label.setGravity(Gravity.CENTER);
        label.setMaxLines(1);

        LinearLayout.LayoutParams labelParams =
                new LinearLayout.LayoutParams(-1, -2);
        labelParams.topMargin = dp(5);
        tile.addView(label, labelParams);

        String packageName = info.activityInfo.packageName;

        tile.setOnClickListener(v -> {
            Intent launch = pm.getLaunchIntentForPackage(packageName);
            if (launch != null) {
                startActivity(launch);
            } else {
                Toast.makeText(this,
                        "App cannot be opened",
                        Toast.LENGTH_SHORT).show();
            }
        });

        GridLayout.LayoutParams params =
                new GridLayout.LayoutParams(
                        GridLayout.spec(index / 4),
                        GridLayout.spec(index % 4, 1f));
        params.width = 0;
        params.height = -2;
        params.setMargins(dp(3), dp(3), dp(3), dp(3));

        grid.addView(tile, params);
    }


    private void addDockApp(
            LinearLayout dock, String packageName,
            String activityName) {

        PackageManager pm = getPackageManager();
        Intent launch = new Intent(Intent.ACTION_MAIN);
        launch.addCategory(Intent.CATEGORY_LAUNCHER);
        launch.setPackage(packageName);

        if (activityName != null) {
            launch.setClassName(packageName, activityName);
        }

        List<ResolveInfo> matches = pm.queryIntentActivities(launch, 0);
        if (matches.isEmpty()) return;

        ResolveInfo info = matches.get(0);

        LinearLayout tile = new LinearLayout(this);
        tile.setOrientation(LinearLayout.VERTICAL);
        tile.setGravity(Gravity.CENTER);
        tile.setPadding(dp(4), dp(8), dp(4), dp(8));

        ImageView icon = new ImageView(this);
        icon.setImageDrawable(info.loadIcon(pm));
        icon.setScaleType(ImageView.ScaleType.FIT_CENTER);
        tile.addView(icon, new LinearLayout.LayoutParams(dp(48), dp(48)));

        TextView label = makeText(
                info.loadLabel(pm).toString(), 10, WHITE);
        label.setGravity(Gravity.CENTER);
        label.setMaxLines(1);

        LinearLayout.LayoutParams labelParams =
                new LinearLayout.LayoutParams(-1, -2);
        labelParams.topMargin = dp(4);
        tile.addView(label, labelParams);

        tile.setOnClickListener(v -> {
            try {
                startActivity(pm.getLaunchIntentForPackage(packageName));
            } catch (Exception e) {
                Toast.makeText(this, "App cannot be opened",
                        Toast.LENGTH_SHORT).show();
            }
        });

        LinearLayout.LayoutParams params =
                new LinearLayout.LayoutParams(0, -2, 1f);
        dock.addView(tile, params);
    }

    private void showHomeScreen() {
        getWindow().setStatusBarColor(Color.BLACK);
        getWindow().setNavigationBarColor(BG);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(dp(22), dp(18), dp(22), dp(20));
        root.setBackgroundColor(BG);

        TextView top = makeText("NOOR", 17, WHITE);
        top.setTypeface(Typeface.DEFAULT_BOLD);
        root.addView(top);

        TextView island = makeText("●          NOOR", 12, WHITE);
        island.setGravity(Gravity.CENTER);
        island.setPadding(dp(24), dp(12), dp(24), dp(12));
        island.setBackgroundColor(Color.BLACK);

        LinearLayout.LayoutParams islandParams =
                new LinearLayout.LayoutParams(dp(190), -2);
        islandParams.gravity = Gravity.CENTER_HORIZONTAL;
        islandParams.topMargin = dp(12);
        root.addView(island, islandParams);

        TextView clock = makeText(
                DateFormat.getTimeFormat(this).format(new Date()),
                64, WHITE);
        clock.setGravity(Gravity.CENTER);
        clock.setTypeface(Typeface.create("sans-serif-light", Typeface.NORMAL));

        LinearLayout.LayoutParams clockParams =
                new LinearLayout.LayoutParams(-1, -2);
        clockParams.topMargin = dp(35);
        root.addView(clock, clockParams);

        TextView date = makeText(
                new SimpleDateFormat("EEEE, d MMMM").format(new Date()),
                16, MUTED);
        date.setGravity(Gravity.CENTER);
        LinearLayout.LayoutParams dateParams =
                new LinearLayout.LayoutParams(-1, -2);
        dateParams.topMargin = dp(4);
        dateParams.bottomMargin = dp(35);
        root.addView(date, dateParams);


        // HOME_SCREEN_APP_GRID
        PackageManager homePm = getPackageManager();
        Intent homeQuery = new Intent(Intent.ACTION_MAIN);
        homeQuery.addCategory(Intent.CATEGORY_LAUNCHER);

        List<ResolveInfo> homeApps =
                homePm.queryIntentActivities(homeQuery, 0);

        Collections.sort(homeApps, new Comparator<ResolveInfo>() {
            @Override
            public int compare(ResolveInfo a, ResolveInfo b) {
                return a.loadLabel(homePm).toString().compareToIgnoreCase(
                        b.loadLabel(homePm).toString());
            }
        });

        GridLayout homeGrid = new GridLayout(this);
        homeGrid.setColumnCount(4);

        int homeCount = Math.min(homeApps.size(), 8);
        for (int i = 0; i < homeCount; i++) {
            addHomeAppIcon(homeGrid, homeApps.get(i), homePm, i);
        }

        LinearLayout.LayoutParams homeGridParams =
                new LinearLayout.LayoutParams(-1, -2);
        homeGridParams.topMargin = dp(22);
        homeGridParams.bottomMargin = dp(18);
        root.addView(homeGrid, homeGridParams);

        TextView apps = makeText("All Apps  →", 16, WHITE);
        apps.setGravity(Gravity.CENTER);
        apps.setPadding(dp(16), dp(16), dp(16), dp(16));
        apps.setBackgroundColor(CARD);
        apps.setOnClickListener(v -> showLauncher());
        root.addView(apps);

        TextView settings = makeText("NOOR Settings  →", 16, WHITE);
        settings.setGravity(Gravity.CENTER);
        settings.setPadding(dp(16), dp(16), dp(16), dp(16));
        settings.setBackgroundColor(CARD);

        LinearLayout.LayoutParams settingsParams =
                new LinearLayout.LayoutParams(-1, -2);
        settingsParams.topMargin = dp(12);
        settings.setOnClickListener(v -> showHome());
        root.addView(settings, settingsParams);

        setContentView(root);
    }

